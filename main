#!/bin/bash
#PBS -N bl_brain_dwi_preproc_slim
#PBS -l nodes=1:ppn=16:gpus=1
#PBS -l vmem=48gb
#PBS -l walltime=23:59:00

# brainlife entrypoint.
#
# brainlife clones this repository into the task directory, writes config.json
# next to it, and runs ./main.  Everything below just picks a container runtime
# and hands over to the driver that does the actual work:
#
#   run.sh        the per-subject pipeline (one diffusion dataset in)
#   run_squad.sh  study-wise eddy QC with eddy_squad (N eddy QC datasets in)
#
# Both are registered on brainlife as separate Apps pointing at this repository;
# which one a task wants is decided from its config.json below, because a group
# App's input ('eddyqc', an array of per-subject QC datasets) has nothing in
# common with the per-subject App's.  The PBS header above sizes the per-subject
# job: group QC reads QC databases rather than images, so it needs neither the
# GPU nor the memory, and the group App should be registered with its own
# (much smaller) resource request.
#
# Environment overrides:
#   APP_IMAGE        container to run (default below).  Either a docker:// URI
#                    or the path to a local .sif.  Must be built and pushed
#                    before the app is registered.
#   EXTRA_BIND       comma- or space-separated host paths to make visible inside
#                    the container, for input data that lives outside the
#                    working directory.
#   SKIP_CONTAINER=1 run directly on the host (FSL/MRtrix3/ANTs must be on PATH)

set -e
set -x

APP_DIR="$(cd "$(dirname "$0")" && pwd)"
export APP_DIR

APP_IMAGE="${APP_IMAGE:-docker://nyeguh/brain-dwi-preproc-slim:1.0.0}"

# eddy, ANTs and MRtrix3 all read their thread counts from the environment, and
# a container runtime only forwards variables carrying its own prefix. Apptainer
# (the continuation of Singularity, and what most clusters now run) reads
# APPTAINERENV_ and still honours SINGULARITYENV_, but logs an INFO line for
# every legacy-prefixed variable it sees. Setting both keeps genuine Singularity
# working and keeps Apptainer quiet.
NCORES="${OMP_NUM_THREADS:-$(nproc 2>/dev/null || echo 8)}"
export OMP_NUM_THREADS="$NCORES"
for prefix in SINGULARITYENV_ APPTAINERENV_; do
    export "${prefix}OMP_NUM_THREADS=$NCORES"
    export "${prefix}ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=$NCORES"
    export "${prefix}MRTRIX_NTHREADS=$NCORES"
    export "${prefix}APP_DIR=$APP_DIR"
done

# --------------------------------------------------------------- which App ----
# An explicit "mode" in config.json wins; otherwise the group App is recognised
# by the input only it has.  jq is not guaranteed on the host -- the container
# carries it, not necessarily the cluster node -- so fall back to grep on the
# config when it is missing rather than refusing to start.
DRIVER="run.sh"
if [ -f config.json ]; then
    if command -v jq >/dev/null 2>&1; then
        MODE="$(jq -r '(.mode // "") | ascii_downcase' config.json 2>/dev/null || echo "")"
        HAS_EDDYQC="$(jq -r 'if ((.eddyqc // .qc_folders // .quad_folders // null) != null) then "yes" else "no" end' config.json 2>/dev/null || echo no)"
    else
        MODE=""
        grep -qE '"(eddyqc|qc_folders|quad_folders)"[[:space:]]*:' config.json && HAS_EDDYQC=yes || HAS_EDDYQC=no
        grep -qE '"mode"[[:space:]]*:[[:space:]]*"(group|squad)"' config.json && MODE=group || true
    fi
    case "$MODE" in
        group|squad) DRIVER="run_squad.sh" ;;
        subject|preproc|"") [ "$HAS_EDDYQC" = yes ] && DRIVER="run_squad.sh" || true ;;
        *) echo "ERROR: unrecognised mode '$MODE' in config.json (use 'subject' or 'group')" >&2; exit 1 ;;
    esac
fi
echo "driver: $DRIVER"

rm -rf output product.json
mkdir -p output

# The working directory and the app itself are always visible inside the
# container.  Anything else -- input data on a different filesystem, say --
# has to be named explicitly, or the container sees an empty path where the
# NIfTI should be.
SING_BIND=(-B "$PWD:$PWD" -B "$APP_DIR:$APP_DIR")
DOCKER_BIND=(-v "$PWD:$PWD" -v "$APP_DIR:$APP_DIR")
if [ -n "${EXTRA_BIND:-}" ]; then
    read -r -a EXTRA_BIND_PATHS <<< "${EXTRA_BIND//,/ }"
    for bind_path in "${EXTRA_BIND_PATHS[@]}"; do
        [ -n "$bind_path" ] || continue
        [ -e "$bind_path" ] || { echo "ERROR: EXTRA_BIND path does not exist: $bind_path" >&2; exit 1; }
        SING_BIND+=(-B "$bind_path:$bind_path")
        DOCKER_BIND+=(-v "$bind_path:$bind_path")
    done
fi

if [ "${SKIP_CONTAINER:-0}" = "1" ]; then
    echo "running on the host (SKIP_CONTAINER=1)"
    "$APP_DIR/$DRIVER"
elif command -v singularity >/dev/null 2>&1; then
    # --nv exposes the host CUDA driver so eddy_cuda can run; it is harmless
    # when there is no GPU, in which case run.sh falls back to a CPU eddy.
    GPU_FLAG=""
    if nvidia-smi -L >/dev/null 2>&1; then GPU_FLAG="--nv"; fi
    # GPU_FLAG is empty or a flag word, so it must stay unquoted.
    # shellcheck disable=SC2086
    singularity exec $GPU_FLAG -e \
        "${SING_BIND[@]}" --pwd "$PWD" \
        "$APP_IMAGE" "$APP_DIR/$DRIVER"
elif command -v docker >/dev/null 2>&1; then
    case "$APP_IMAGE" in
        *.sif|*.simg)
            echo "ERROR: APP_IMAGE is a singularity image ($APP_IMAGE) but singularity is not installed." >&2
            echo "       Install singularity/apptainer, or set APP_IMAGE to a docker:// image." >&2
            exit 1 ;;
    esac
    GPU_FLAG=""
    if nvidia-smi -L >/dev/null 2>&1; then GPU_FLAG="--gpus all"; fi
    # shellcheck disable=SC2086
    docker run --rm $GPU_FLAG \
        "${DOCKER_BIND[@]}" -w "$PWD" \
        -e OMP_NUM_THREADS="$NCORES" \
        -e ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS="$NCORES" \
        -e MRTRIX_NTHREADS="$NCORES" \
        -e APP_DIR="$APP_DIR" \
        -u "$(id -u):$(id -g)" \
        "${APP_IMAGE#docker://}" "$APP_DIR/$DRIVER"
else
    echo "no singularity or docker found; falling back to the host toolchain" >&2
    "$APP_DIR/$DRIVER"
fi

# brainlife treats a non-zero exit as a failed task, so assert on the one file
# that means this task actually produced its result.
if [ "$DRIVER" = run_squad.sh ]; then
    EXPECTED="output/squad/group_db.json"
else
    EXPECTED="output/tensor/fa.nii.gz"
fi
if [ ! -f "$EXPECTED" ]; then
    echo "ERROR: $EXPECTED was not produced" >&2
    exit 1
fi
echo "done"
